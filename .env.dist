###> symfony service configuration ###
SERVER_NAME=localhost
HTTP_PORT=80
HTTP_METRICS_PORT=2019
HTTPS_PORT=443
HTTP3_PORT=443

MYSQL_VERSION=8.4.7
MYSQL_CHARSET=utf8mb4
MYSQL_DATABASE=app
MYSQL_ROOT_PASSWORD=!ChangeMe!
MYSQL_USER=app
MYSQL_PASSWORD=!ChangeMe!
PHPMYADMIN_PORT=8080

APP_SECRET=!ChangeMe!
CADDY_MERCURE_URL=http://php/.well-known/mercure
CADDY_MERCURE_PUBLIC_URL=https://${SERVER_NAME:-localhost}:${HTTPS_PORT:-443}/.well-known/mercure
CADDY_MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
###< symfony service configuration ###





###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=!ChangeMe!
APP_NAME="Symfony Docker"
###< symfony/framework-bundle ###

